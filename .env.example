# Buyer script configuration. Copy to .env and fill in. .env is gitignored.

# Seller endpoint. Local wrangler dev by default; the deployed Worker URL later.
SELLER_URL=http://localhost:8787

# Buyer wallet. Leave empty on first run: `pnpm wallet` generates a key,
# writes it here, and prints the address to fund. Keep the balance under 20 USD.
BUYER_PRIVATE_KEY=

# CAIP-2 network id. base-sepolia for all functional tests.
NETWORK=eip155:84532

# JSON-RPC endpoint used only for balance checks and the one-time Permit2 approval.
RPC_URL=https://sepolia.base.org

# USDC contract on base-sepolia (Circle). Override for other networks.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Where JSONL results are written. Relative paths resolve from the repo root.
RESULTS_DIR=results
